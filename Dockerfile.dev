# Development Dockerfile (Production-ready build for performance)
FROM node:20-alpine

WORKDIR /app

COPY package.json package-lock.json* ./

# Do NOT set NODE_ENV=production before install: npm omits devDependencies,
# but `next build` needs TypeScript (and other devDeps) to load `next.config.ts`.
ENV NEXT_TELEMETRY_DISABLED=1

ARG NEXT_PUBLIC_API_BASE_URL
ARG NEXT_PUBLIC_USE_PROXY
ARG NEXT_PUBLIC_APP_NAME
ARG NEXT_PUBLIC_SOCKET_URL

ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL
ENV NEXT_PUBLIC_USE_PROXY=$NEXT_PUBLIC_USE_PROXY
ENV NEXT_PUBLIC_APP_NAME=$NEXT_PUBLIC_APP_NAME
ENV NEXT_PUBLIC_SOCKET_URL=$NEXT_PUBLIC_SOCKET_URL

RUN npm install

COPY . .

RUN npm run build

ENV NODE_ENV=production

EXPOSE 3000

CMD ["npm", "start"]